{
  "name": "plumetrace-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "copy:replay": "node -e \"const fs=require('node:fs');fs.rmSync('public/replay',{recursive:true,force:true});fs.cpSync('../replay','public/replay',{recursive:true});console.log('replay files copied')\"",
    "predev": "npm run copy:replay",
    "dev": "vite",
    "prebuild": "npm run copy:replay",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:replay": "npm run copy:replay && tsc --noEmit -p tsconfig.json && vite build --mode replay",
    "check:replay-bundle": "node scripts/check-replay-bundle.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gen:types": "json2ts -i src/shared/types/generated/contract.schema.json -o src/shared/types/generated/contract.ts --bannerComment \"/* GENERATED by npm run gen:types from contract.schema.json - do not edit. */\""
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "three": "0.187.0",
    "uplot": "1.6.32",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-jsdoc": "65.4.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "json-schema-to-typescript": "16.0.0",
    "r3f-perf": "7.2.3",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
