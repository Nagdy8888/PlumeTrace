# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=plumetrace-dev
# Local Supabase Postgres (printed by `npx supabase start` from app/; default local port 54322)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# OpenAI model ids (not secrets; owner decision 2026-11-13: gpt-6-luna for both roles)
OPENAI_MODEL_FAST=
OPENAI_MODEL_REASONING=
# Total USD cap for all paid OpenAI calls, enforced from plumetrace.llm_calls (owner sets it)
PLUMETRACE_SPEND_CAP_USD=
